# ─────────────────────────────────────────────────────────────────────────────
# VOLTMAXHUB Rental Platform — Environment Variables
# Ko'chirish: cp .env.example .env  va qiymatlarni to'ldirish
# MUHIM: .env hech qachon Git'ga tushmasin!
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,voltmaxhub.uz,www.voltmaxhub.uz,powerbank011.netlify.app

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=voltmaxhub_db
DB_USER=voltmaxhub_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://voltmaxhub.uz,https://www.voltmaxhub.uz,https://powerbank011.netlify.app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Click Payment ─────────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=https://voltmaxhub.uz/payment/success

# ── Payme Payment ─────────────────────────────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_RETURN_URL=https://voltmaxhub.uz/payment/success

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Media & Static ────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Admin Notifications (ixtiyoriy) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── KYC Data Encryption (MAJBURIY — pasport/PINFL shifrlash uchun) ───────────
# AES-256-GCM kaliti. Qiymat bo'sh qoldiriladi — haqiqiy kalitni FAQAT production
# server Environment Variables'da kiriting. Hech qachon .env.example'ga yozmang.
# Tavsiya etilgan: 32 ta tasodifiy bayt, hex ko'rinishida (openssl rand -hex 32).
# Qabul qilinadigan formatlar: 64 hex belgi | base64(32 bayt) | 16+ belgili passphrase.
KYC_ENCRYPTION_KEY=

# ── Admin Security ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-secure-admin-password-here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Server (Node.js / dotenv) uchun:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend (Vite) uchun — VITE_ prefiksi majburiy:
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Production (Netlify): backend URL, oxirida / yo'q
# VITE_API_URL=https://powerbank-eq86.onrender.com

# Node API (Render/Railway):
# PORT=3001
# NODE_ENV=production
# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Prisma / Node API. Render'ning ichki DATABASE_URL'ini shu yerga qo'ying:
#   postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>?schema=public&sslmode=require
# Render ichki (Internal) URL parolsiz bo'lishi mumkin:
#   postgresql://<USER>@<HOST>:<PORT>/<DB>?schema=public
# Qiymat bo'sh qoldiriladi — haqiqiy parolni FAQAT Render Environment
# Variables (yoki .env) ichiga kiriting. Bu faylga yozmang.
DATABASE_URL=
# JWT_SECRET=change-this-secret
FRONTEND_ORIGIN=https://voltmaxhub.uz,https://www.voltmaxhub.uz,https://powerbank011.netlify.app
