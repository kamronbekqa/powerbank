# ─────────────────────────────────────────────────────────────────────────────
# MECO Rental Platform — Environment Variables
# Ko'chirish: cp .env.example .env  va qiymatlarni to'ldirish
# MUHIM: .env hech qachon Git'ga tushmasin!
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=meco_db
DB_USER=meco_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Click Payment ─────────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=http://localhost:5173/payment/success

# ── Payme Payment ─────────────────────────────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_RETURN_URL=http://localhost:5173/payment/success

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Media & Static ────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Admin Notifications (ixtiyoriy) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Server (Node.js / dotenv) uchun:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Frontend (Vite) uchun — VITE_ prefiksi majburiy:
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
