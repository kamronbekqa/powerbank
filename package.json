{
  "name": "voltmaxhub-platform",
  "private": true,
  "version": "1.0.0",
  "description": "VOLTMAXHUB Website & Rental Platform",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:local:start && npm run db:setup && (node server/index.js & npm --prefix frontend run dev)",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && venv/bin/python manage.py runserver",
    "dev:server": "npm run db:local:start && npm run db:setup && node server/index.js",
    "start": "prisma migrate deploy && node server/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "db:local:start": "$HOME/.local/pgsql/bin/pg_ctl -D $HOME/.local/pgdata -l $HOME/.local/pgdata/server.log -o \"-p 55432 -k $HOME/.local/pgrun -c listen_addresses=127.0.0.1\" start",
    "db:local:stop": "$HOME/.local/pgsql/bin/pg_ctl -D $HOME/.local/pgdata stop -m fast",
    "db:local:status": "$HOME/.local/pgsql/bin/pg_ctl -D $HOME/.local/pgdata status"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {}
}